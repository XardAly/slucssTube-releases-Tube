<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_row_divider">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="0dp" android:paddingTop="20dp" android:paddingBottom="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="12dp">
            <ImageView android:id="@+id/jobIcon" android:layout_width="32dp" android:layout_height="32dp" android:padding="4dp" android:importantForAccessibility="no" />
            <TextView android:id="@+id/jobType" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:letterSpacing="0" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/text_secondary" />
            <TextView android:id="@+id/jobState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/jobTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/jobStatus" android:maxLines="3" android:ellipsize="end" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:lineSpacingExtra="2dp" android:textColor="@color/text_secondary" android:textSize="14sp" />
        <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/jobProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:max="100" app:indicatorColor="@color/red_brand" app:trackColor="@color/surface_elevated" app:trackCornerRadius="3dp" app:trackThickness="6dp" />
        <TextView android:id="@+id/jobDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textColor="@color/text_muted" android:textSize="12sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/jobRetryButton" style="@style/Widget.Slucss.SecondaryButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Tentar novamente" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/jobShareButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Compartilhar" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="end" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/jobOpenButton" style="@style/Widget.Slucss.SecondaryButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Abrir" android:textAllCaps="false" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/jobErrorButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Ver erro" android:textAllCaps="false" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/jobFallbackButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Tentar servidor" android:textAllCaps="false" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/jobCancelButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Cancelar" android:textAllCaps="false" android:textColor="@color/red_highlight" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
