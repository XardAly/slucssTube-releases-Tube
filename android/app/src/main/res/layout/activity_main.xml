            <com.google.android.material.chip.ChipGroup android:id="@+id/queueFilters" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true" app:singleLine="false" app:checkedChip="@id/filterAll" android:layout_marginTop="12dp" app:chipSpacingHorizontal="4dp" app:chipSpacingVertical="0dp">
                <com.google.android.material.chip.Chip android:id="@+id/filterAll" style="@style/Widget.Slucss.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Todos" android:checkable="true" android:textSize="13sp" />
                <com.google.android.material.chip.Chip android:id="@+id/filterActive" style="@style/Widget.Slucss.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ativos" android:checkable="true" android:textSize="13sp" />
                <com.google.android.material.chip.Chip android:id="@+id/filterCompleted" style="@style/Widget.Slucss.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Concluídos" android:checkable="true" android:textSize="13sp" />
                <com.google.android.material.chip.Chip android:id="@+id/filterFailed" style="@style/Widget.Slucss.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Falhas" android:checkable="true" android:textSize="13sp" />
            </com.google.android.material.chip.ChipGroup>
            <ScrollView android:id="@+id/emptyQueueState" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:scrollbars="none" android:overScrollMode="never">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="top|start" android:orientation="vertical" android:padding="0dp" android:paddingTop="44dp">
                    <TextView android:id="@+id/emptyQueueText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:gravity="start" android:text="Tudo pronto para começar." android:textColor="@color/text_secondary" android:textSize="16sp" android:lineSpacingExtra="4dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/emptyQueueAction" style="@style/Widget.Slucss.SecondaryButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Baixar vídeo" android:layout_gravity="start" />
                </LinearLayout>
            </ScrollView>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/jobsList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingTop="14dp" android:paddingBottom="24dp" android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
