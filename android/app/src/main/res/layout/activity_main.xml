<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/black_deep" android:orientation="vertical" android:focusableInTouchMode="true">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="64dp" android:background="@android:color/transparent" app:contentInsetStart="0dp" app:contentInsetEnd="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingHorizontal="20dp">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="@string/app_name" android:src="@drawable/ic_slucss_mark" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="slucss." android:fontFamily="sans-serif-black" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/settingsButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:padding="12dp" android:contentDescription="Configurações" app:icon="@drawable/ic_settings" app:iconPadding="0dp" app:iconTint="@color/text_secondary" />
            <com.google.android.material.button.MaterialButton android:id="@+id/updateButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="0dp" android:paddingHorizontal="10dp" android:text="Atualizar" android:textAllCaps="false" android:textColor="@color/text_secondary" android:textSize="13sp" app:icon="@drawable/ic_refresh" app:iconSize="16dp" app:iconTint="@color/text_secondary" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ScrollView android:id="@+id/downloadSection" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true" android:overScrollMode="never" android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="@dimen/studio_page_top" android:paddingEnd="20dp" android:paddingBottom="30dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Baixar vídeo" android:textSize="32sp" android:textColor="@color/text_primary" android:fontFamily="sans-serif" android:layout_marginBottom="0dp" android:layout_weight="1" android:textStyle="bold" android:letterSpacing="-0.025" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Baixe vídeos ou extraia o áudio." android:textSize="14sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="3dp" android:layout_marginTop="6dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="0dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="Link do vídeo" android:textSize="14sp" android:textColor="@color/text_primary" android:lineSpacingExtra="3dp" android:fontFamily="sans-serif-medium" android:labelFor="@id/urlInput" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="https://" app:boxBackgroundColor="@color/surface_alt" app:boxCornerRadiusBottomEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusTopStart="12dp" app:boxStrokeColor="@color/input_outline" app:endIconMode="clear_text" app:hintEnabled="false">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/urlInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:imeOptions="actionGo" android:inputType="textUri" android:maxLines="1" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" android:textSize="16sp" android:minHeight="56dp" android:hint="Cole o link aqui" android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.button.MaterialButton android:id="@+id/pasteButton" style="@style/Widget.Slucss.SecondaryButton" android:layout_width="wrap_content" android:layout_height="56dp" android:layout_marginStart="8dp" android:minWidth="76dp" android:text="@string/paste" android:textSize="14sp" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/analyzeButton" style="@style/Widget.Slucss.PrimaryButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:text="Buscar vídeo" app:icon="@drawable/ic_search" app:iconGravity="textStart" />
                    <TextView android:id="@+id/linkStatus" android:accessibilityLiveRegion="polite" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1  Link   →   2  Qualidade   →   3  Download" android:textSize="12sp" android:textColor="@color/text_muted" android:lineSpacingExtra="3dp" android:layout_marginTop="12dp" />
                    <ProgressBar android:id="@+id/analyzeProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginHorizontal="8dp" android:layout_marginTop="10dp" android:indeterminate="true" android:indeterminateTint="@color/red_brand" android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/cancelAnalysisButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Cancelar análise" android:visibility="gone" />
                    <TextView android:accessibilityLiveRegion="polite" android:id="@+id/videoInfoText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="2dp" android:text="" android:textColor="@color/text_secondary" android:textSize="14sp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/analysisErrorButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="4dp" android:text="Ver erro" android:textAllCaps="false" android:visibility="gone" />
                    <LinearLayout android:id="@+id/videoPreview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
                        <ImageView android:id="@+id/videoThumbnail" android:layout_width="120dp" android:layout_height="68dp" android:background="@drawable/bg_thumbnail" android:clipToOutline="true" android:contentDescription="Capa do vídeo" android:scaleType="centerCrop" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/videoTitleText" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:lineSpacingExtra="2dp" android:maxLines="2" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
                            <TextView android:id="@+id/videoMetaText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="2" android:textColor="@color/text_muted" android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/downloadOptions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="18dp" android:background="@color/border" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Escolha seu download" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Conteúdo" android:textColor="@color/text_secondary" android:textSize="14sp" />
                        <Spinner android:id="@+id/modeSpinner" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="6dp" android:background="@drawable/bg_select" android:paddingEnd="40dp" android:popupBackground="@color/surface_elevated" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:text="Qualidade" android:textColor="@color/text_secondary" android:textSize="14sp" />
                        <Spinner android:id="@+id/qualitySpinner" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="6dp" android:background="@drawable/bg_select" android:paddingEnd="40dp" android:popupBackground="@color/surface_elevated" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:text="Formato" android:textColor="@color/text_secondary" android:textSize="14sp" />
                        <Spinner android:id="@+id/formatSpinner" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="6dp" android:background="@drawable/bg_select" android:paddingEnd="40dp" android:popupBackground="@color/surface_elevated" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/enqueueButton" style="@style/Widget.Slucss.PrimaryButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp" android:enabled="false" android:text="Baixar arquivo" app:icon="@drawable/ic_nav_download" app:iconGravity="textStart" />
                        <TextView android:accessibilityLiveRegion="polite" android:id="@+id/downloadMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:textColor="@color/text_secondary" android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="28dp" android:background="@color/border" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Recentes" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text_primary" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/viewQueueButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Ver fila" android:textColor="@color/red_highlight" />
                </LinearLayout>
                <TextView android:id="@+id/recentEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Seus arquivos e o andamento dos downloads aparecem aqui." android:textColor="@color/text_secondary" android:textSize="16sp" android:lineSpacingExtra="4dp" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/recentJobs" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </ScrollView>
        <ScrollView android:id="@+id/gifSection" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true" android:overScrollMode="never" android:scrollbars="none" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="@dimen/studio_page_top" android:paddingEnd="20dp" android:paddingBottom="30dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Criar GIF" android:textSize="32sp" android:textColor="@color/text_primary" android:fontFamily="sans-serif" android:layout_marginBottom="0dp" android:textStyle="bold" android:letterSpacing="-0.025" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Transforme um trecho do seu vídeo em GIF." android:textSize="14sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="3dp" android:layout_marginTop="6dp" android:layout_marginBottom="28dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="0dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Arquivo de origem" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/pickGifSourceButton" style="@style/Widget.Slucss.FileButton" android:layout_width="match_parent" android:layout_height="104dp" android:layout_marginTop="12dp" android:text="Selecionar vídeo" app:icon="@drawable/ic_source_file" app:iconGravity="textTop" android:textSize="15sp" app:iconPadding="10dp" app:iconSize="26dp" app:iconTint="@color/text_secondary" />
                    <TextView android:id="@+id/gifSourceText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:ellipsize="middle" android:maxLines="2" android:text="Nenhum arquivo selecionado" android:textColor="@color/text_muted" android:textSize="12sp" android:gravity="center" android:layout_marginBottom="8dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Trecho" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Início (s)" app:boxBackgroundColor="@color/surface_alt" app:boxStrokeColor="@color/input_outline" app:boxCornerRadiusBottomEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusTopStart="12dp">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/gifStartInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:text="0" android:textColor="@color/text_primary" android:textSize="16sp" android:minHeight="56dp" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:hint="Fim (s)" app:boxBackgroundColor="@color/surface_alt" app:boxStrokeColor="@color/input_outline" app:boxCornerRadiusBottomEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusTopStart="12dp">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/gifEndInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:text="5" android:textColor="@color/text_primary" android:textSize="16sp" android:minHeight="56dp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:text="Resolução" android:textColor="@color/text_secondary" android:textSize="14sp" />
                            <Spinner android:id="@+id/gifResolutionSpinner" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="6dp" android:background="@drawable/bg_select" android:paddingEnd="40dp" android:popupBackground="@color/surface_elevated" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:text="Fluidez" android:textColor="@color/text_secondary" android:textSize="14sp" />
                            <Spinner android:id="@+id/gifFpsSpinner" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="6dp" android:background="@drawable/bg_select" android:paddingEnd="40dp" android:popupBackground="@color/surface_elevated" />
                        </LinearLayout>
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/createGifButton" style="@style/Widget.Slucss.PrimaryButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp" android:text="Criar GIF" />
                    <TextView android:id="@+id/gifMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <ScrollView android:id="@+id/compatibilitySection" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true" android:overScrollMode="never" android:scrollbars="none" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="@dimen/studio_page_top" android:paddingEnd="20dp" android:paddingBottom="30dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Converter" android:textSize="32sp" android:textColor="@color/text_primary" android:fontFamily="sans-serif" android:layout_marginBottom="0dp" android:textStyle="bold" android:letterSpacing="-0.025" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Prepare seu vídeo para usar em outros editores." android:textSize="14sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="3dp" android:layout_marginTop="6dp" android:layout_marginBottom="28dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="0dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Arquivo de origem" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/pickCompatibilitySourceButton" style="@style/Widget.Slucss.FileButton" android:layout_width="match_parent" android:layout_height="104dp" android:layout_marginTop="12dp" android:text="Selecionar vídeo" app:icon="@drawable/ic_source_file" app:iconGravity="textTop" android:textSize="15sp" app:iconPadding="10dp" app:iconSize="26dp" app:iconTint="@color/text_secondary" />
                    <TextView android:id="@+id/compatibilitySourceText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:ellipsize="middle" android:maxLines="2" android:text="Nenhum arquivo selecionado" android:textColor="@color/text_muted" android:textSize="12sp" android:gravity="center" android:layout_marginBottom="8dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="24dp" android:paddingVertical="16dp" android:background="@drawable/bg_output_row">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Formato de saída" android:textSize="14sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="3dp" android:layout_weight="1" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MP4" android:textSize="16sp" android:textColor="@color/text_primary" android:lineSpacingExtra="3dp" android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/convertButton" style="@style/Widget.Slucss.PrimaryButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp" android:text="Converter para MP4" />
                    <TextView android:id="@+id/compatibilityMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <ScrollView android:id="@+id/upscaleSection" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true" android:overScrollMode="never" android:scrollbars="none" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="@dimen/studio_page_top" android:paddingEnd="20dp" android:paddingBottom="30dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Upscale" android:textSize="32sp" android:textColor="@color/text_primary" android:fontFamily="sans-serif" android:layout_marginBottom="0dp" android:textStyle="bold" android:letterSpacing="-0.025" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Amplie a resolução com processamento por IA." android:textSize="14sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="3dp" android:layout_marginTop="6dp" android:layout_marginBottom="28dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="0dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Arquivo de origem" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/pickUpscaleSourceButton" style="@style/Widget.Slucss.FileButton" android:layout_width="match_parent" android:layout_height="104dp" android:layout_marginTop="12dp" android:text="Selecionar vídeo" app:icon="@drawable/ic_source_file" app:iconGravity="textTop" android:textSize="15sp" app:iconPadding="10dp" app:iconSize="26dp" app:iconTint="@color/text_secondary" />
                    <TextView android:id="@+id/upscaleSourceText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:ellipsize="middle" android:maxLines="2" android:text="Nenhum arquivo selecionado" android:textColor="@color/text_muted" android:textSize="12sp" android:gravity="center" android:layout_marginBottom="8dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Modelo de IA" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                    <Spinner android:id="@+id/upscaleModelSpinner" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:background="@drawable/bg_select" android:paddingEnd="40dp" android:popupBackground="@color/surface_elevated" />
                    <TextView android:id="@+id/upscaleModelDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/text_secondary" android:textSize="14sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Escala" android:textColor="@color/text_secondary" android:textSize="14sp" />
                    <Spinner android:id="@+id/upscaleScaleSpinner" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="6dp" android:background="@drawable/bg_select" android:paddingEnd="40dp" android:popupBackground="@color/surface_elevated" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:text="Saída: Automático — recomendado" android:textColor="@color/text_secondary" android:textSize="14sp" />
                    <TextView android:id="@+id/upscaleHardwareText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="O hardware será verificado antes de iniciar." android:textColor="@color/text_muted" android:textSize="14sp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/startUpscaleButton" style="@style/Widget.Slucss.PrimaryButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp" android:text="Iniciar Upscale" />
                    <TextView android:id="@+id/upscaleMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <LinearLayout android:id="@+id/queueSection" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="@dimen/studio_page_top" android:paddingEnd="20dp" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fila" android:textColor="@color/text_primary" android:textSize="32sp" android:fontFamily="sans-serif" android:textStyle="bold" android:letterSpacing="-0.025" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/clearQueueButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Limpar" android:textAllCaps="false" android:textColor="@color/text_secondary" />
