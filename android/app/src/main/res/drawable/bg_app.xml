<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo do app: gradiente vertical para um preto mais profundo na base
     com um brilho vermelho quase imperceptível no topo, como no site. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:endColor="@color/black_bottom"
                android:startColor="@color/black_deep"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:centerX="0.5"
                android:centerY="0"
                android:endColor="#00E50914"
                android:gradientRadius="900"
                android:startColor="#0DE50914"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
