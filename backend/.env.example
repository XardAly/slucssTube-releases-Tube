# ============================================================
# XARD YT SYSTEM — Backend (.env)
# NUNCA versionar o .env real. Copie para .env e preencha.
# ============================================================

# --- Banco / API ---------------------------------------------------
DATABASE_URL=postgresql+psycopg2://xard:CHANGE_ME@postgres:5432/xard?sslmode=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
POSTGRES_PASSWORD=CHANGE_ME
API_LIMIT_CONCURRENCY=500
API_BACKLOG=256
API_GRACEFUL_SHUTDOWN_SECONDS=30
VIDEO_INFO_CONCURRENCY=1
VIDEO_INFO_CACHE_TTL_SECONDS=900
VIDEO_INFO_CACHE_SIZE=128

# --- Fila persistente da API ---------------------------------------
MAX_CONCURRENT_TASKS=1
TASK_TIMEOUT=1800
TASK_RETENTION_TIME=2592000
TEMP_FILE_RETENTION=86400
MAX_TASKS_PER_USER=2
MAX_QUEUE_SIZE=100
TASK_POLL_INTERVAL=0.5
TASK_STALE_SECONDS=120
TASK_MAX_RETRIES=3
TASK_CANCEL_GRACE_SECONDS=5
TASK_CLEANUP_INTERVAL=900
TASK_ORPHAN_CLEANUP_INTERVAL=86400
TASK_STORAGE_RECOVERY_INTERVAL=300
TASK_STORAGE_AUDIT_INTERVAL=900
MEDIA_CACHE_RECOVERY_INTERVAL=60
PROGRESS_UPDATE_INTERVAL=1.0
PROGRESS_UPDATE_STEP=2.0
TASK_CANCEL_CHECK_INTERVAL=0.5
WORKER_MEMORY_LIMIT_MB=512
COMPATIBILITY_TRANSCODE_MIN_MEMORY_MB=768
COMPATIBILITY_TRANSCODE_MIN_AVAILABLE_MB=384
# Com tarefas já rodando, novas só iniciam se o cgroup indicar ao menos esta
# folga; sem cgroup real (ex.: Windows dev), este limite não se aplica.
TASK_ADMISSION_MIN_AVAILABLE_MB=200

# --- WebSocket (estado oficial no PostgreSQL) -----------------------
WEBSOCKET_ENABLED=true
WEBSOCKET_TICKET_TTL_SECONDS=60
WEBSOCKET_HEARTBEAT_SECONDS=25
WEBSOCKET_PONG_TIMEOUT_SECONDS=60
WEBSOCKET_MAX_MESSAGE_BYTES=16384
WEBSOCKET_MAX_SUBSCRIPTIONS=100
WEBSOCKET_MAX_CONNECTIONS_PER_DEVICE=4
WEBSOCKET_MAX_CONNECTIONS_PER_IP=20
WEBSOCKET_MESSAGES_PER_MINUTE=120
WEBSOCKET_CLIENT_QUEUE_SIZE=100
# Origens extras separadas por vírgula; WEB_ORIGIN já é incluída.
WEBSOCKET_ALLOWED_ORIGINS=

# --- JWT (sessões temporárias) --------------------------------------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME
JWT_ISSUER=xard-api
JWT_ACCESS_AUDIENCE=xard-api
JWT_WEBSOCKET_AUDIENCE=xard-websocket
JWT_CLOCK_SKEW_SECONDS=15
ACCESS_TOKEN_TTL_MINUTES=10
REFRESH_TOKEN_TTL_DAYS=7

# --- Painel administrativo ------------------------------------------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Vazio = painel admin desabilitado (fail closed).
ADMIN_API_KEY=

# --- Chave Ed25519 do servidor (assina manifestos de versão etc.) --
# Prioridade de carregamento (a primeira não vazia decide): PATH > B64 > PEM
# literal > SERVER_KEYS_DIR (legado). Em produção, uma das quatro é
# obrigatória — nenhuma chave é gerada automaticamente. Veja
# backend/SERVER_SIGNING_KEY.md para gerar, converter e fazer backup.
#
# 1) Secret mount (hospedagem com suporte a arquivo persistente):
SERVER_SIGNING_PRIVATE_KEY_PATH=
# 2) Base64 do PEM (recomendado quando não há secret mount, ex.: Square Cloud):
SERVER_SIGNING_PRIVATE_KEY_B64=
# 3) PEM literal (aceita \n escapado se o painel não permitir múltiplas linhas):
SERVER_SIGNING_PRIVATE_KEY_PEM=
# 4) Legado: diretório com server_ed25519_{private,public}.pem já montado.
#    Fora de produção, gerado uma vez e persistido para os próximos boots.
SERVER_KEYS_DIR=/srv/keys

# --- Anti-replay / assinatura de requisições -----------------------
SIGNATURE_MAX_SKEW_SECONDS=120
CHALLENGE_TTL_SECONDS=60

# --- Versionamento do app ------------------------------------------
APP_LATEST_VERSION=1.6.0
APP_MINIMUM_VERSION=1.0.0
APP_DOWNLOAD_URL=https://downloads.xard.com/XARD-YT-SYSTEM-Setup.exe
# SHA-256 do instalador publicado (recomendado: valida o download no cliente)
APP_DOWNLOAD_SHA256=
# Liberação e versão mínima somente do Upscale local do desktop.
UPSCALE_ENABLED=true
UPSCALE_MINIMUM_VERSION=1.6.0

# --- Android (APK distribuído diretamente pelo site) -------------
ANDROID_LATEST_VERSION=1.2.1
ANDROID_LATEST_VERSION_CODE=21
ANDROID_MINIMUM_VERSION=1.0.0
ANDROID_MINIMUM_VERSION_CODE=1
ANDROID_DOWNLOAD_URL=https://github.com/SEU_USUARIO/SEU_REPOSITORIO/releases/download/android-v1.2.1/Slucss-System.apk
ANDROID_DOWNLOAD_SHA256=
ANDROID_APK_FILE=./Slucss-System.apk
ANDROID_INSTALLER_URL=https://github.com/SEU_USUARIO/SEU_REPOSITORIO/releases/download/android-v1.0.0/Slucss-System-Installer-1.0.1.apk
ANDROID_INSTALLER_APK_FILE=./Slucss-System-Installer-1.0.1.apk
ANDROID_CHANGELOG_JSON=["Versão inicial para Android"]
ANDROID_PROCESSING_MODE=local
ANDROID_SERVER_FALLBACK_ENABLED=false
ANDROID_SIDELOAD_ENABLED=true
ANDROID_UPSCALE_ENABLED=true
ANDROID_UPSCALE_MINIMUM_VERSION=1.2.0
ANDROID_UPSCALE_MINIMUM_VERSION_CODE=20
ANDROID_UPSCALE_ENGINE_VERSION=ncnn-20260526-v1
ANDROID_ANIMEVIDEOV3_MODEL_VERSION=animevideov3-ncnn-v1
ANDROID_REALCUGAN_MODEL_VERSION=realcugan-se-conservative-v1

# --- Integridade do cliente ----------------------------------------
# Hashes SHA-256 dos executáveis Windows oficiais (separados por vírgula)
ALLOWED_WINDOWS_APP_HASHES=
# Play Integrity (Android)
PLAY_INTEGRITY_PACKAGE_NAME=com.xard.ytsystem
PLAY_INTEGRITY_DECODE_URL=https://playintegrity.googleapis.com/v1
GOOGLE_SERVICE_ACCOUNT_JSON=/srv/keys/google-service-account.json
# Em dev, permite pular attestation (NUNCA em produção):
INTEGRITY_ENFORCED=true

# --- Limites (serviço gratuito → anti-abuso, por dispositivo) -------
DAILY_DOWNLOADS_PER_DEVICE=30
HOURLY_DOWNLOADS_PER_DEVICE=10
CONCURRENT_DOWNLOADS_PER_DEVICE=2
MAX_FILE_SIZE_MB=2048
RATE_LIMIT_PER_MINUTE=120
SESSIONS_PER_IP_PER_HOUR=30

# --- Processamento / armazenamento temporário ----------------------
# Precisa ficar fora da árvore de pacotes Python do backend: a limpeza de
# resíduos varre este diretório inteiro e apagaria o código-fonte. Caminhos
# como ./downloads são rejeitados na carga da configuração.
DOWNLOADS_DIR=/srv/downloads
DOWNLOAD_FILE_TTL_HOURS=6
DOWNLOAD_TOKEN_TTL_SECONDS=300
MEDIA_CACHE_ENABLED=true
MEDIA_CACHE_PROCESSING_STALE_SECONDS=3600
MEDIA_CACHE_VALIDATION_TIMEOUT_SECONDS=15
TEMP_STORAGE_MAX_MB=4096
TEMP_STORAGE_MIN_FREE_MB=256
MAX_DOWNLOAD_JOBS=1
MAX_FFMPEG_JOBS=1

# Backend final: local mantém o comportamento antigo; google_drive remove a
# cópia local somente depois de confirmar metadados e persistir o ID privado.
STORAGE_BACKEND=local
STORAGE_ALLOW_LOCAL_FALLBACK=true
STORAGE_KEEP_SOURCE_UPLOADS=false
STORAGE_KEEP_DOWNLOADED_SOURCE_VIDEOS=true
STORAGE_KEEP_GENERATED_GIFS=true
STORAGE_LOCAL_FALLBACK_MAX_SIZE_MB=4096
STORAGE_LOCAL_FALLBACK_TTL_SECONDS=21600

# Google Drive pessoal privado via OAuth 2.0. Segredos sempre vazios no exemplo.
GOOGLE_DRIVE_AUTH_MODE=oauth
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# O assistente preenche estes IDs; o backend também consegue criar as subpastas.
GOOGLE_DRIVE_VIDEOS_FOLDER_ID=
GOOGLE_DRIVE_GIFS_FOLDER_ID=
GOOGLE_DRIVE_UPLOAD_CHUNK_SIZE_MB=8
GOOGLE_DRIVE_UPLOAD_TIMEOUT_SECONDS=900
GOOGLE_DRIVE_UPLOAD_MAX_RETRIES=4
REMOTE_DOWNLOAD_CHUNK_SIZE_MB=1
GOOGLE_DRIVE_MAX_CONCURRENT_UPLOADS=2
GOOGLE_DRIVE_MAX_CONCURRENT_DOWNLOADS=8
GOOGLE_DRIVE_MIN_FREE_SPACE_MB=2048
GOOGLE_DRIVE_MAX_FILE_SIZE_MB=2048
GOOGLE_DRIVE_STORAGE_ALERT_PERCENT=90
GOOGLE_DRIVE_PERMANENT_DELETE_EXPIRED=true
REMOTE_DOWNLOAD_TIMEOUT_SECONDS=900
REMOTE_DELETE_MAX_RETRIES=4

# Cache local de chunks remotos (diferente do MEDIA_CACHE persistente); continua
# desativado para não consumir disco/RAM do container sem benefício medido.
REMOTE_CACHE_ENABLED=false
REMOTE_CACHE_MAX_SIZE_MB=1024
REMOTE_CACHE_TTL_SECONDS=1800
# FFmpeg: vazio = cálculo seguro por afinidade/cgroups e concorrência total.
GIF_FFMPEG_THREADS=
GIF_FFMPEG_FILTER_THREADS=
GIF_FFMPEG_TIMEOUT_SECONDS=600
# Redução adaptativa (a primeira tentativa sempre preserva as opções manuais).
GIF_MAX_ENCODINGS=3
GIF_SIZE_SAFETY_MARGIN=0.88
GIF_MIN_FPS=5
GIF_MIN_COLORS=32
GIF_MIN_WIDTH=160
GIF_MIN_HEIGHT=120
# Ative apenas quando o Nginx tiver o location internal correspondente.
NGINX_INTERNAL_DOWNLOADS_ENABLED=false
NGINX_INTERNAL_DOWNLOADS_URI=/internal-downloads
# Cookies do YouTube (formato Netscape): contorna anti-bot em IP de datacenter
YTDLP_COOKIES_FILE=
# Sessão do X/Twitter (Netscape, base64) — NUNCA colocar no cookies.txt
# compartilhado: aquele arquivo é servido pro app em /video/cookies.
TWITTER_COOKIES_B64=
# Downloads são de releases imutáveis e falham sem os quatro hashes.
WORKER_BINARY_DOWNLOADS_ENABLED=true
FFMPEG_WINDOWS_ARCHIVE_SHA256=1438403bcc1104d9ecb47b04f8a818602b8d64839c374d607f231903b316eda1
FFMPEG_LINUX_ARCHIVE_SHA256=7a19456683e31d937ae48d51e23dfb869dbb9db1e4d6e1b6881d7fed168fa5cf
DENO_WINDOWS_ARCHIVE_SHA256=5fb5bac71f609fb91ec8960fb290885aadc27eeb22f07a8eca0c3db6be38b11a
DENO_LINUX_ARCHIVE_SHA256=2d7bb6195226ac832e0bf7109a115f0af65ee69ac797a4bbde5b27a06cc242d9

# --- CORS (site oficial) --------------------------------------------
WEB_ORIGIN=https://xard.com

# --- Notificações ----------------------------------------------------
# Webhook do Discord para avisos de download (vazio = desabilitado)
DISCORD_DOWNLOAD_WEBHOOK_URL=
DISCORD_SECURITY_WEBHOOK_ENABLED=false
DISCORD_SECURITY_WEBHOOK_URL=
DISCORD_SECURITY_WEBHOOK_MIN_SEVERITY=medium
DISCORD_SECURITY_WEBHOOK_TIMEOUT_SECONDS=5
DISCORD_SECURITY_WEBHOOK_INCLUDE_FULL_IP=false
DISCORD_SECURITY_WEBHOOK_RATE_LIMIT_PER_MINUTE=20
DISCORD_SECURITY_WEBHOOK_ENVIRONMENT=production
SECURITY_LOG_HMAC_KEY=CHANGE_ME

# Configure CIDRs reais do Nginx/plataforma. O segredo deve coincidir com o Next.
TRUSTED_PROXY_CIDRS=
INTERNAL_PROXY_SECRET=CHANGE_ME

# --- Ambiente -------------------------------------------------------
ENVIRONMENT=production

# Release Android: identidade estável, publicação deduplicada no PostgreSQL.
# android-release.json do pacote fornece metadados públicos sem alterar o .env.
ANDROID_RELEASE_ID=
ANDROID_UPDATE_POLICY=recommended
